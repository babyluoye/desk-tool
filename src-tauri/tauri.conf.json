{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskTool",
  "version": "0.1.0",
  "identifier": "com.newapi.desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskTool",
        "width": 1180,
        "height": 820,
        "minWidth": 200,
        "minHeight": 280,
        "resizable": true,
        "decorations": false
      },
      {
        "label": "capture",
        "title": "区域截图",
        "url": "index.html#capture",
        "width": 800,
        "height": 600,
        "shadow": false,
        "backgroundColor": [16, 21, 29, 255],
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https:; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
